rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is owner
    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }
    
    // Helper function to check if user is student
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated();
    }
    
    // Complaints collection
    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isStudent();
      allow update: if isOwner() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isOwner();
    }
    
    // Washing Bookings collection
    match /washing_bookings/{bookingId} {
      // Anyone authenticated can read (to check availability)
      allow read: if isAuthenticated();
      
      // Students can create bookings for themselves
      allow create: if isStudent() && 
                       request.resource.data.studentId == request.auth.uid;
      
      // Students can delete their own bookings, owners can delete any
      allow delete: if isAuthenticated() && 
                       (resource.data.studentId == request.auth.uid || isOwner());
      
      // No updates allowed (delete and recreate instead)
      allow update: if false;
    }
    
    // Dinner Voting collection
    match /dinner_voting/{votingId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    
    // Dinner Votes collection
    match /dinner_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isStudent();
      allow update: if isStudent() && resource.data.studentId == request.auth.uid;
      allow delete: if isOwner() || (isStudent() && resource.data.studentId == request.auth.uid);
    }
    
    // Messages/Chat collection
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isOwner() || resource.data.senderId == request.auth.uid;
    }
    
    // Owner Setup collection
    match /owner_setup/{ownerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
  }
}
